{
  "name": "code-metrics-backend",
  "version": "2.58.0",
  "description": "Backend for the code-metrics service",
  "main": "src/index.js",
  "scripts": {
    "build": "npm run gen-metadata && node esbuild.config.mjs",
    "circular-dependency-scan": "npx madge ./src --extensions ts,js --circular",
    "copy-dev-license-pubkey": "cp public-keys/pubkey-license-dev.json src/license/pubkey-license.json",
    "copy-release-license-pubkey": "cp public-keys/pubkey-license-release.json src/license/pubkey-license.json",
    "dev": "node --env-file=.env esbuild.config.mjs --watch",
    "debug": "node --env-file=.env esbuild.config.mjs --debug && node --env-file=.env --inspect-brk ./dist/index.js",
    "format": "prettier --write \"**/*.+(js|ts|json)\"",
    "gen-metadata": "node ./generate-metadata.js",
    "lambda": "lambda/build.sh",
    "lint": "eslint .",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "predev": "npm run copy-dev-license-pubkey",
    "prestart": "npm run copy-dev-license-pubkey",
    "pretest": "npm run copy-dev-license-pubkey",
    "pretest:integration:full": "npm run pretest",
    "pretest:integration": "npm run pretest",
    "pretest:aws-local-int": "npm run pretest",
    "pretest:e2e:aws-local-deploy": "npm run pretest",
    "pretest:slow": "npm run pretest",
    "pretest:full-coverage": "npm run pretest",
    "release": "npm run release:prod",
    "release:dev": "npm run copy-dev-license-pubkey && npm run build",
    "release:prod": "npm run copy-release-license-pubkey && npm run build",
    "start": "node --env-file=.env ./dist/index.js",
    "test": "npm run test:unit",
    "test:unit": "jest --group=-integration --group=-slow --group=-aws-local-int --group=-aws-local-deploy --coverageDirectory='coverage-be--unit'",
    "test:integration:full": "npm run test:integration && npm run test:aws-local-int",
    "test:integration": "jest --maxWorkers=1 --group=integration --coverageDirectory='coverage-be--integration'",
    "test:aws-local-int": "jest --maxWorkers=1 --group=aws-local-int --coverageDirectory='coverage-be--aws-local'",
    "test:e2e:aws-local-deploy": "jest --maxWorkers=1 --group=aws-local-deploy --coverage=false",
    "test:slow": "jest --maxWorkers=1 --group=slow --coverageDirectory='coverage-be--slow'",
    "test:full-coverage": "jest --coverageDirectory='coverage-be--full'"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DeloitteDigitalUK/code-metrics.git"
  },
  "author": "DeloitteDigitalUK",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DeloitteDigitalUK/code-metrics/issues"
  },
  "homepage": "https://github.com/DeloitteDigitalUK/code-metrics#readme",
  "dependencies": {
    "@aws-sdk/client-codepipeline": "^3.1080.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1080.0",
    "@aws-sdk/client-dynamodb": "^3.1080.0",
    "@aws-sdk/client-secrets-manager": "^3.1080.0",
    "@aws-sdk/util-dynamodb": "^3.996.5",
    "@azure/identity": "^4.13.1",
    "@codegenie/serverless-express": "^5.0.0",
    "@google/generative-ai": "^0.24.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/openapi": "^22.0.0",
    "@octokit/rest": "^22.0.1",
    "@seald-io/nedb": "^4.1.2",
    "@smithy/protocol-http": "^5.5.6",
    "@smithy/querystring-builder": "^4.4.6",
    "@tensorflow/tfjs": "^4.22.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "azure-devops-node-api": "^15.1.2",
    "bitbucket": "^2.12.0",
    "bottleneck": "^2.19.5",
    "command-line-args": "^6.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "jenkins": "^1.1.0",
    "js-yaml": "^5.2.2",
    "json-2-csv": "^5.5.11",
    "jsonpath-plus": "^10.4.0",
    "jsonwebtoken": "^9.0.3",
    "keycloak-backend": "^5.1.0",
    "ldap-authentication": "^4.0.4",
    "lodash": "^4.18.1",
    "log-timestamp": "^0.3.0",
    "mongodb": "^7.4.0",
    "morgan": "^1.11.0",
    "ms": "^2.1.3",
    "openid-client": "^6.8.4",
    "parse-diff": "^0.12.0",
    "parse-git-diff": "^0.0.20"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1080.0",
    "@aws-sdk/client-lambda": "^3.1080.0",
    "@eslint/js": "^10.0.1",
    "@imposter-js/imposter": "^2.5.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jenkins": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonpath-plus": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "asciichart": "^1.5.25",
    "command-line-args": "^6.0.2",
    "esbuild": "0.28.1",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-runner-groups": "^2.2.0",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
