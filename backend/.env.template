## Strict mode (abort load if missing license or config)
STRICT_CONFIG_LOAD=false

## Code coverage threshold overrides
# COVERAGE_THRESHOLD_DANGER=30
# COVERAGE_THRESHOLD_WARNING=80

## Override for *-config.json files (default = current dir)
# CONFIG_DIR=
# CONFIG_DIR=./config/examples # Example config files included in repo

## Configuration loading options - useful for development
# CONFIG_AUTO_RELOAD=false
# CONFIG_REFRESH_MS=5000

# Feature flags (set to true to enable)
FEATURE_DORA_METRICS=
FEATURE_LANGUAGE_SELECTOR=
FEATURE_ML_FORECASTS=
FEATURE_PREDICTIONS=

## UI details
UI_BASE_URL=http://code-metrics.localhost:3001
CORS_ORIGIN=https://code-metrics.localhost:3001

## CodeMetrics Application Authentication
AUTHENTICATOR_IMPL=file
ACCESS_TOKEN_SECRET=changeme
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=60m

## Client-side session store method (one of: cookie, sessionstorage)
CLIENT_SESSION_STORE=cookie

## Cognito authenticator settings
# AUTHENTICATOR_IMPL=cognito
# COGNITO_USER_POOL_ID=changeme
# COGNITO_CLIENT_ID=changeme

## OIDC settings
# AUTHENTICATOR_IMPL=oidc
# OIDC_ISSUER_BASE_URL=http://localhost:8086/realms/codemetrics
# OIDC_CLIENT_ID=codemetrics
# OIDC_CLIENT_SECRET=changeme
# OIDC_USER_CLAIM=sub
# OIDC_SCOPES=openid profile email
# OIDC_AUDIENCE=codemetrics
# OIDC_USE_PKCE=false

## Log response bodies
LOG_RESPONSE_BODY=false

## Emit HTTP access logs (Express/Morgan)
LOG_ACCESS_LOGS=false

## Application Logging (set to 0 / OFF, 1 / DEBUG or 2 / VERBOSE)
LOG_LEVEL=1

## number of API retries on error
# API_RETRY_LIMIT=5

## Whether the cache is enabled (requires datastore)
LOOKUP_CACHE_ENABLED=true

## Global AWS Config
# AWS_REGION=eu-west-1

## The datastore implementation (one of: inmem, dynamodb, mongodb, localdb)
DATASTORE_IMPL=inmem

## Local DB datastore settings
# DATASTORE_PATH=./data

## DynamoDB datastore settings
# DATABASE_NAME=CodeMetrics

## MongoDB datastore settings
# DATABASE_URI=mongodb://code-metrics:changeme@localhost:27017
# DATABASE_NAME=code-metrics

## Secret resolver settings (one of: file, secretsmanager)
# SECRET_RESOLVER_IMPL=file

## AWS endpoint override for LocalStack
# AWS_ENDPOINT_URL=http://localhost:4566

## AWS credentials (any value works for LocalStack)
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
