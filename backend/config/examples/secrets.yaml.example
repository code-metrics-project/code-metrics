# Example secrets file for CodeMetrics
# Copy this file to 'secrets.yaml' and fill in your actual values.
# NEVER commit secrets.yaml to version control!
#
# Usage: Reference these secrets in remote-config.yaml using ${secret.SECRET_NAME}
# Example: apiKey: "${secret.GITHUB_PAT}"

# GitHub Personal Access Token (for BEARER_TOKEN auth)
GITHUB_PAT: "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# GitHub App credentials (for GITHUB_APP auth)
# Get these values from your GitHub App settings page
GITHUB_APP_ID: "123456"
GITHUB_APP_INSTALLATION_ID: "12345678"

# GitHub App Private Key
# Option 1: Paste the entire key content (with newlines preserved)
GITHUB_APP_PRIVATE_KEY: |
  -----BEGIN RSA PRIVATE KEY-----
  MIIEpAIBAAKCAQEA...
  (your private key content here)
  ...
  -----END RSA PRIVATE KEY-----

# Option 2: If your secret resolver supports file references,
# you can store the key in a separate file and reference it.
# Check your deployment environment for supported formats.

# Other common secrets
AZURE_DEVOPS_PAT: "your-azure-pat-here"
JIRA_API_KEY: "your-jira-api-key-here"
SONAR_API_KEY: "your-sonar-api-key-here"

# AI Agent API Keys (optional - only needed if using LLM features)
# Anthropic Claude: Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY: "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google Gemini: Get your API key from https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY: "AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
