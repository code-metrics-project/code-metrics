{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "WorkloadId": { "type": "string" },
    "RepoGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "items": { "$ref": "#/definitions/SoftwareComponent" }
        },
        "sonarTags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SoftwareComponent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "repo": { "type": "string" },
        "exclude": { "type": "boolean" },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["repo"]
    },
    "JobGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobNames": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "RepoCodeAnalysisMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "componentName": { "type": "string" },
        "vcsRepoName": { "type": "string" }
      },
      "required": ["key"]
    },
    "TeamWorkingPattern": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startHour": { "type": "number" },
        "endHour": { "type": "number" },
        "startDay": {
          "oneOf": [{ "type": "number" }, { "type": "string" }]
        },
        "endDay": {
          "oneOf": [{ "type": "number" }, { "type": "string" }]
        },
        "timezone": { "type": "string" }
      }
    },
    "WorkloadTeamConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workingPattern": { "$ref": "#/definitions/TeamWorkingPattern" }
      }
    },
    "WorkloadCodeManagementConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "serverId": { "type": "string" },
        "projectName": { "type": "string" },
        "repoGroups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/RepoGroup" }
        }
      },
      "required": ["type", "serverId", "projectName", "repoGroups"]
    },
    "WorkloadPipelineStage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stageId": { "type": "string" },
        "jobMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["stageId"]
    },
    "WorkloadPipelinesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "serverId": { "type": "string" },
        "projectName": { "type": "string" },
        "jobNameMapping": { "type": "string" },
        "jobGroups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/JobGroup" }
        },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkloadPipelineStage" }
        }
      },
      "required": ["stages"]
    },
    "WorkloadCodeAnalysisConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "serverId": { "type": "string" },
        "branch": { "type": "string" },
        "componentKeyPrefix": { "type": "string" },
        "mappings": {
          "type": "array",
          "items": { "$ref": "#/definitions/RepoCodeAnalysisMapping" }
        }
      },
      "required": ["type", "serverId"]
    },
    "BaseWorkloadTicketConfig": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "serverId": { "type": "string" }
      },
      "required": ["type", "serverId"]
    },
    "WorkloadTicketConfigAzure": {
      "allOf": [
        { "$ref": "#/definitions/BaseWorkloadTicketConfig" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "azure" },
            "team": { "type": "string" },
            "projectName": { "type": "string" },
            "teamFilterQuery": { "type": "string" },
            "ticketTypes": { "type": "string" },
            "ticketPriorities": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["type", "team", "projectName"]
        }
      ]
    },
    "WorkloadTicketConfigJira": {
      "allOf": [
        { "$ref": "#/definitions/BaseWorkloadTicketConfig" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "jira" },
            "projectName": { "type": "string" },
            "teamFilterQuery": { "type": "string" },
            "ticketTypes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "ticketPriorities": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["type", "projectName"]
        }
      ]
    },
    "WorkloadTicketConfigNone": {
      "allOf": [
        { "$ref": "#/definitions/BaseWorkloadTicketConfig" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "none" }
          },
          "required": ["type"]
        }
      ]
    },
    "WorkloadTicketConfigServiceNow": {
      "allOf": [
        { "$ref": "#/definitions/BaseWorkloadTicketConfig" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "servicenow" },
            "tableName": { "type": "string" },
            "teamFilterQuery": { "type": "string" }
          },
          "required": ["type"]
        }
      ]
    },
    "WorkloadTicketConfig": {
      "oneOf": [
        { "$ref": "#/definitions/WorkloadTicketConfigAzure" },
        { "$ref": "#/definitions/WorkloadTicketConfigJira" },
        { "$ref": "#/definitions/WorkloadTicketConfigNone" },
        { "$ref": "#/definitions/WorkloadTicketConfigServiceNow" }
      ]
    },
    "Workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/WorkloadId" },
        "name": { "type": "string" },
        "team": { "$ref": "#/definitions/WorkloadTeamConfig" },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "codeManagement": { "$ref": "#/definitions/WorkloadCodeManagementConfig" },
        "codeAnalysis": { "$ref": "#/definitions/WorkloadCodeAnalysisConfig" },
        "incidents": { "$ref": "#/definitions/WorkloadTicketConfig" },
        "pipelines": { "$ref": "#/definitions/WorkloadPipelinesConfig" },
        "projectManagement": { "$ref": "#/definitions/WorkloadTicketConfig" }
      },
      "required": ["id", "codeManagement", "codeAnalysis", "incidents", "pipelines", "projectManagement"]
    }
  },
  "additionalProperties": false,
  "properties": {
    "workloads": {
      "type": "array",
      "items": { "$ref": "#/definitions/Workload" }
    },
    "version": { "type": "string" }
  },
  "required": ["workloads", "version"]
}
