{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quality Gates Configuration",
  "type": "object",
  "properties": {
    "quality-gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "environments": {
            "type": "array",
            "items": { "type": "string" }
          },
          "gates": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "version", "environments", "gates"],
        "additionalProperties": false
      }
    }
  },
  "required": ["quality-gates"],
  "additionalProperties": false
}
