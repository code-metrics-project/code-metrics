{
  "css.customData": ["./promosite/vscode.tailwind.json"],
  "editor.codeActionsOnSave": ["source.fixAll.eslint", "source.formatDocument"],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "astro", "typescript", "typescriptreact"],
  "files.associations": {
    "*.mdx": "markdown"
  },
  "prettier.documentSelectors": ["**/*.astro"],
  "typescript.inlayHints.parameterTypes.enabled": true,
  "volar.takeOverMode.enabled": false,
  "yaml.schemas": {
    "./.vscode/astrowind/config-schema.json": "/src/config.yaml"
  },
  "[promosite]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "[ui]": {
    "volar.takeOverMode.enabled": true,
    "volar.configFile": "ui/volar.config.js"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  }
}
