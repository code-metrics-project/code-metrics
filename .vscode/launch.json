{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "./promosite/node_modules/.bin/astro dev",
      "name": "Astro Development server",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Backend",
      "port": 9229,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/backend/dist/**/*.js"
      ]
    }
  ]
}
