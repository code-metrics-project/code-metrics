{
  "name": "code-metrics-tool",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Code Metrics tool - analysis on Project Issues, Codebase and Code Quality Tooling data",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DeloitteDigitalUK/code-metrics.git"
  },
  "author": "DeloitteDigitalUK",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DeloitteDigitalUK/code-metrics/issues"
  },
  "homepage": "https://github.com/DeloitteDigitalUK/code-metrics#readme",
  "scripts": {
    "dev": "vite",
    "build": "npm-run-all type-check build-only",
    "cypress:open": "cypress open",
    "preview": "npm run build && vite preview --port 3001",
    "test": "CI=true npm run test:unit",
    "test:unit": "vitest --environment jsdom --root src/",
    "test:unit:coverage": "vitest --environment jsdom --root src/ --coverage",
    "test:e2e": "start-server-and-test 'npm run dev' http://localhost:3001 'cypress run --e2e --spec \"__tests__/e2e/specs/regression/**\"'",
    "test:e2e:headless": "start-server-and-test 'npm run dev' http://localhost:3001 'cypress run --e2e --headless --spec \"__tests__/e2e/specs/regression/**\"'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4001 'cypress open --e2e'",
    "test:e2e:keycloak": "start-server-and-test 'npm run dev' http://localhost:3001 'cypress run --e2e --spec \"__tests__/e2e/specs/oidc/keycloak-login.cy.ts\"'",
    "test:e2e:oidc": "start-server-and-test 'npm run dev' http://localhost:3001 'cypress run --e2e --spec \"__tests__/e2e/specs/oidc/oidc-login.cy.ts\"'",
    "test:e2e:smoke": "start-server-and-test 'npm run dev' http://localhost:3001 'cypress run --e2e --spec \"__tests__/e2e/specs/smoke/**\"'",
    "test:e2e:all": "start-server-and-test 'npm run dev' http://localhost:3001 'cypress run --e2e'",
    "build-only": "cross-env NODE_ENV=production && vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tanstack/vue-query": "^5.66.9",
    "apexcharts": "^4.5.0",
    "axios": "^1.12.2",
    "date-fns": "^4.1.0",
    "json-2-csv": "^5.5.8",
    "lodash": "^4.17.21",
    "pinia": "^3.0.1",
    "uuid": "^11.1.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.10",
    "vue-router": "^4.5.0",
    "vue3-apexcharts": "1.8.0",
    "vuetify": "^3.10.4"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/js": "^9.20.0",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "cypress": "^15.8.2",
    "eslint": "^9.31.0",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.1",
    "sass": "^1.85.0",
    "start-server-and-test": "^2.0.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.4.1",
    "vite-plugin-istanbul": "^7.0.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vitest": "^3.0.6",
    "vue-tsc": "^2.2.2"
  }
}
