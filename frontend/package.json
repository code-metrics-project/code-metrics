{
  "name": "code-metrics-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CodeMetrics tool - analysis on Project Issues, Codebase and Code Quality Tooling data",
  "scripts": {
    "dev": "bun run vite",
    "build": "bun run tsc --noEmit && bun run vite build",
    "build-only": "bun run cross-env NODE_ENV=production && bun run vite build",
    "preview": "bun run build && bun run vite preview --port 3001",
    "prettier": "prettier --check .",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "lint": "bun run eslint src",
    "lint:fix": "bun run eslint src --fix",
    "type-check": "bun run tsc --noEmit",
    "test": "CI=true bun run test:unit",
    "test:unit": "bun run vitest --environment jsdom --root src/",
    "test:unit:coverage": "bun run vitest --environment jsdom --root src/ --coverage",
    "test:e2e:install": "bun run playwright install chromium",
    "test:e2e:dev": "bun run playwright test --ui",
    "test:e2e:run": "bun run playwright test --project=chromium",
    "test:e2e": "bun run playwright test __tests__/playwright/specs/regression",
    "test:e2e:coverage": "cross-env COVERAGE_ENABLED=true bun run playwright test __tests__/playwright/specs/regression",
    "test:e2e:headless": "bun run playwright test __tests__/playwright/specs/regression --reporter=list",
    "test:e2e:keycloak": "bun run playwright test __tests__/playwright/specs/oidc/keycloak-login.spec.ts",
    "test:e2e:keycloak:coverage": "cross-env COVERAGE_ENABLED=true bun run playwright test __tests__/playwright/specs/oidc/keycloak-login.spec.ts",
    "test:e2e:oidc": "bun run playwright test __tests__/playwright/specs/oidc/oidc-login.spec.ts",
    "test:e2e:oidc:coverage": "cross-env COVERAGE_ENABLED=true bun run playwright test __tests__/playwright/specs/oidc/oidc-login.spec.ts",
    "test:e2e:smoke": "bun run playwright test __tests__/playwright/specs/smoke",
    "test:e2e:all": "bun run playwright test",
    "test:e2e:report": "bun run playwright show-report __tests__/output/playwright-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/node": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "json-2-csv": "^5.5.10",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.5.4",
    "react-resizable-panels": "^4.6.5",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.59.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.1",
    "eslint-plugin-tailwind-canonical-classes": "^1.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "uuid": "^13.0.0",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^4.0.18"
  }
}
